@startuml
skinparam classAttributeIconSize 0

class DirectoryDoors {
- {static} allDoors : Door[]
+ {static} makeDoors()
+ {static} findDoorById(id : String) : Door
+ {static} getAllDoors() : Door[]
}

DirectoryDoors --> "*" Door : "allDoors"

class Door implements ClockObserver{
- id : String
- closed : boolean
- locked : boolean
- propped : boolean
- unlockedShortly : boolean
- unlockTime : LocalDateTime
- fromSpace : Space
- toSpace : Space
+ processRequest(request : RequestReader)
'+ toJson() : JSONObject
'+ toString() : String
'+ isClosed() :boolean
- doAction(action : String)
+ getFromSpace() : Space
+ getToSpace() : Space
+ update(now : LocalDateTime)
}

class DirectoryUsers {
- {static} users : User[]
+ {static} makeUsers()
+ {static} findUserByCredential(credential : String) : User
}

DirectoryUsers --> "*" User : "users"

class User {
- name : String
- credential : String
'+ toString() : String
+ getUserGroup() : UserGroup
+ canBeInSpace(space : Space) : boolean
+ canPerformAction(action : String ) : boolean
}

class DirectoryUserGroups {
- {static} userGroups : UserGroup[]
+ {static} makeUserGroups()
+ {static} getUserGroups() : UserGroup[]
}

class UserGroup {
- name : String
- users : User[]
+ findUserByCredential(credential : String) : User
+ getName() : String
+ getUsers() : String[]
}

class DirectoryAreas {
- {static} rootArea : Area
- {static} allDoors : Door[]
+ {static} makeArea()
+ {static} findAreaById(String id) : Area
+ {static} findDoorById(String id) : Door
+ {static} getAllDoors() : Door[]
}

DirectoryAreas --> "1" Area : "rootArea"

class Area {
- id : String
- parent : Area
+ getDoorsGivingAccess() : Door[]
+ findAreaById(String id) : Area
+ getSpaces() : Space[]

}

class Partition {
- children : Area[]
+ getDoorsGivingAccess() : Door[]
+ findAreaById(String id) : Area
+ getSpaces() : Space[]
+ addChild(area : Area)
}

class Space {
- doors : Door[]
+ addDoorGivingAccess(door : Door)
+ getDoorsGivingAccess() : Door[]
+ findAreaById(String id) : Area
+ getSpaces() : Space[]
}

Space --> "*" Door : "doors"
Space <-- "1" Door : "getFromSpace(), getToSpace()"

DirectoryUserGroups o-- "1..*" UserGroup : userGroups
UserGroup *-- "*" User : users

Area <|-- Partition
Area <|-- Space

Space <-- "1" User : canBeInSpace

class Clock {
- {static} instance : Clock
- observers : ClockObserver[]
- Clock()
}

interface ClockObserver {
  update(now : LocalDateTime)
}

Clock --> "*" ClockObserver : ClockObserver

class Main {
+ {static} main(args : String)
}

note right of Main::main
DirectoryAreas.makeArea()
DirectoryUsers.makeUsers()
DirectoryUserGroups.makeUserGroups()

end note
@enduml
